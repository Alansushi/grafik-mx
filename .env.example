# Configurador /estudio/ — nombres de variables, SIN valores.
#
# Ninguna de estas va al repo. Se configuran en Vercel → Project → Environment
# Variables, con scope Production + Preview. `.env*` está en .gitignore y en
# .vercelignore.
#
# El navegador NO recibe ninguna de estas: todas se leen sólo dentro de api/*.js.
# La única excepción son SUPABASE_URL y SUPABASE_ANON_KEY, que el panel de admin
# usa desde el cliente — y son públicas por diseño (RLS es lo que protege, no el
# secreto de la anon key).

# ── Supabase ──────────────────────────────────────────────────────────────────
# Proyecto: grafik-estudio · ref xnqejebfqradgudewyhc · región us-east-1
#
# NOMBRES DE LAS KEYS: Supabase las renombró. Las variables de aquí conservan el
# nombre del ROL (anon / service_role) porque describe el NIVEL DE PRIVILEGIO,
# que es lo que importa para el código y no cambió. Pero en el panel se llaman
# distinto:
#
#   legacy          panel hoy          va en
#   ───────────────────────────────────────────────────────────
#   anon            Publishable key    SUPABASE_ANON_KEY
#   service_role    Secret key         SUPABASE_SERVICE_ROLE_KEY
#
# Los dos formatos funcionan — verificado: /api/catalog devuelve lo mismo con la
# anon legacy (eyJ...) que con la publishable (sb_publishable_...). Las legacy
# siguen vivas hasta fin de 2026, pero las nuevas se rotan por separado, así que
# para un proyecto nuevo conviene usar las nuevas.
#
# Dónde: Dashboard → grafik-estudio → Settings → API Keys →
#        pestaña "Publishable and secret API keys"

# PÚBLICA por diseño: va al navegador. Lo que protege no es su secreto, sino RLS
# + los GRANT de 0003_rls.sql — verificado: con ella, pricing_rules y orders
# devuelven 401, no filas vacías.
SUPABASE_URL=https://xnqejebfqradgudewyhc.supabase.co
SUPABASE_ANON_KEY=

# SECRETA. Salta RLS por completo: si se filtra, se expone toda la base. SÓLO en
# api/*.js, jamás en el navegador ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=

# ── Mercado Pago ──────────────────────────────────────────────────────────────
# TEST-... en desarrollo, APP_USR-... en producción.
# El prefijo NO es cosmético: con APP_USR- el candado de precios placeholder
# bloquea el cobro (spec §2.6, assertChargeable).
MP_ACCESS_TOKEN=
# Secreto de la firma del webhook. Sin él, /api/webhook-mp responde 503.
# No existe ningún modo que salte la verificación.
MP_WEBHOOK_SECRET=
# Opcional: sobrescribe notification_url (útil para apuntar a ngrok en local
# sin romper las back_urls del navegador).
MP_WEBHOOK_URL=

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Remitente completo, formato: "GRAFIK <pedidos@grafik.mx>"
# En desarrollo: "GRAFIK <onboarding@resend.dev>" — sólo entrega a la dirección
# dueña de la cuenta de Resend.
EMAIL_FROM=
# Destino de la notificación interna de pedido nuevo.
ADMIN_NOTIFY_EMAIL=
# 0 desactiva el adjunto PNG y usa una URL firmada en el correo (fallback del
# spec §7.7 si attachments de Resend falla).
EMAIL_ATTACH_PREVIEW=1

# ── URLs ──────────────────────────────────────────────────────────────────────
# Base absoluta para back_urls de Mercado Pago. DEBE ser https o MP rechaza
# auto_return. Si no se define, se deriva de VERCEL_URL (que NO trae esquema —
# hay que anteponer https:// a mano).
PUBLIC_BASE_URL=

# Opcional. Dominios que /api/track acepta (coma). Por defecto: grafik.mx,www.grafik.mx.
# Añade un dominio de preview de Vercel sólo mientras pruebas la analítica ahí.
TRACK_ALLOWED_HOSTS=
