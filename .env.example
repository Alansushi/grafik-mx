# Configurador /estudio/ — nombres de variables, SIN valores.
#
# Ninguna de estas va al repo. Se configuran en Vercel → Project → Environment
# Variables, con scope Production + Preview. `.env*` está en .gitignore y en
# .vercelignore.
#
# El navegador NO recibe ninguna de estas: todas se leen sólo dentro de api/*.js.
# La única excepción son SUPABASE_URL y SUPABASE_ANON_KEY, que el panel de admin
# usa desde el cliente — y son públicas por diseño (RLS es lo que protege, no el
# secreto de la anon key).

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Salta RLS. Sólo en functions. Si se filtra, se expone toda la base.
SUPABASE_SERVICE_ROLE_KEY=

# ── Mercado Pago ──────────────────────────────────────────────────────────────
# TEST-... en desarrollo, APP_USR-... en producción.
# El prefijo NO es cosmético: con APP_USR- el candado de precios placeholder
# bloquea el cobro (spec §2.6, assertChargeable).
MP_ACCESS_TOKEN=
# Secreto de la firma del webhook. Sin él, /api/webhook-mp responde 503.
# No existe ningún modo que salte la verificación.
MP_WEBHOOK_SECRET=
# Opcional: sobrescribe notification_url (útil para apuntar a ngrok en local
# sin romper las back_urls del navegador).
MP_WEBHOOK_URL=

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Remitente completo, formato: "GRAFIK <pedidos@grafik.mx>"
# En desarrollo: "GRAFIK <onboarding@resend.dev>" — sólo entrega a la dirección
# dueña de la cuenta de Resend.
EMAIL_FROM=
# Destino de la notificación interna de pedido nuevo.
ADMIN_NOTIFY_EMAIL=
# 0 desactiva el adjunto PNG y usa una URL firmada en el correo (fallback del
# spec §7.7 si attachments de Resend falla).
EMAIL_ATTACH_PREVIEW=1

# ── URLs ──────────────────────────────────────────────────────────────────────
# Base absoluta para back_urls de Mercado Pago. DEBE ser https o MP rechaza
# auto_return. Si no se define, se deriva de VERCEL_URL (que NO trae esquema —
# hay que anteponer https:// a mano).
PUBLIC_BASE_URL=
